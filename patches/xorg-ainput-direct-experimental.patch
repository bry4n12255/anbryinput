+static int
+AInputDeviceEventValuatorCount(DeviceEvent *ev)
+{
+    if (ev->type != ET_Motion)
+        return 0;
+
+    if (!BitIsOn(ev->valuators.mask, 0) ||
+        !BitIsOn(ev->valuators.mask, 1))
+        return -1;
+
+    return 2;
+}
+
+static inline FP1616
+AInputDoubleToFP1616(double in)
+{
+    return (FP1616) (in * 65536.0);
+}
+
+static inline FP3232
+AInputDoubleToFP3232(double in)
+{
+    FP3232 ret;
+    int32_t integral;
+    double tmp = floor(in);
+
+    integral = (int32_t) tmp;
+    ret.integral = integral;
+    ret.frac = (uint32_t) ((in - integral) * (1ULL << 32));
+
+    return ret;
+}
+
+static int
+eventToAInputDeviceEvent(DeviceEvent *ev, xEvent **xi)
+{
+    int btlen = bytes_to_int32(bits_to_bytes(MAX_BUTTONS));
+    int vallen = bytes_to_int32(bits_to_bytes(MAX_VALUATORS));
+    int nvals = AInputDeviceEventValuatorCount(ev);
+    int len;
+    xXIDeviceEvent *xde;
+    char *ptr;
+    FP3232 *axisval;
+
+    if (nvals < 0)
+        return eventToDeviceEvent(ev, xi);
+
+    len = sizeof(xXIDeviceEvent) + btlen * 4 + vallen * 4;
+    len += nvals * sizeof(FP3232);
+
+    *xi = malloc(len);
+    if (*xi == NULL)
+        return BadAlloc;
+
+    xde = (xXIDeviceEvent *) *xi;
+    memset(xde, 0, sizeof(*xde));
+    xde->type = GenericEvent;
+    xde->extension = IReqCode;
+    xde->evtype = GetXI2Type(ev->type);
+    xde->time = ev->time;
+    xde->length = bytes_to_int32(len - sizeof(xEvent));
+    xde->detail = ev->detail.button;
+    xde->root = ev->root;
+    xde->buttons_len = btlen;
+    xde->valuators_len = vallen;
+    xde->deviceid = ev->deviceid;
+    xde->sourceid = ev->sourceid;
+    xde->root_x = AInputDoubleToFP1616(ev->root_x + ev->root_x_frac);
+    xde->root_y = AInputDoubleToFP1616(ev->root_y + ev->root_y_frac);
+    xde->flags = ev->flags & ~AINPUT_FAST_EVENT;
+
+    if (ev->key_repeat)
+        xde->flags |= XIKeyRepeat;
+
+    xde->mods.base_mods = ev->mods.base;
+    xde->mods.latched_mods = ev->mods.latched;
+    xde->mods.locked_mods = ev->mods.locked;
+    xde->mods.effective_mods = ev->mods.effective;
+
+    xde->group.base_group = ev->group.base;
+    xde->group.latched_group = ev->group.latched;
+    xde->group.locked_group = ev->group.locked;
+    xde->group.effective_group = ev->group.effective;
+
+    ptr = (char *) &xde[1];
+    memset(ptr, 0, xde->buttons_len * 4 + xde->valuators_len * 4);
+    memcpy(ptr, ev->buttons, sizeof(ev->buttons));
+
+    if (nvals == 2) {
+        ptr += xde->buttons_len * 4;
+        axisval = (FP3232 *) (ptr + xde->valuators_len * 4);
+        SetBit(ptr, 0);
+        SetBit(ptr, 1);
+        axisval[0] = AInputDoubleToFP3232(ev->valuators.data[0]);
+        axisval[1] = AInputDoubleToFP3232(ev->valuators.data[1]);
+    }
+
+    return Success;
+}
+
+static int
+eventToAInputRawEvent(RawDeviceEvent *ev, xEvent **xi)
+{
+    int vallen = bytes_to_int32(bits_to_bytes(MAX_VALUATORS));
+    int nvals = (ev->type == ET_RawMotion) ? 2 : 0;
+    int len;
+    xXIRawEvent *raw;
+    char *ptr;
+    FP3232 *axisval, *axisval_raw;
+
+    if (ev->type == ET_RawMotion &&
+        (!BitIsOn(ev->valuators.mask, 0) ||
+         !BitIsOn(ev->valuators.mask, 1)))
+        return eventToRawEvent(ev, xi);
+
+    len = sizeof(xXIRawEvent) + vallen * 4;
+    len += nvals * sizeof(FP3232) * 2;
+
+    *xi = malloc(len);
+    if (*xi == NULL)
+        return BadAlloc;
+
+    raw = (xXIRawEvent *) *xi;
+    memset(raw, 0, sizeof(*raw));
+    raw->type = GenericEvent;
+    raw->extension = IReqCode;
+    raw->evtype = GetXI2Type(ev->type);
+    raw->time = ev->time;
+    raw->length = bytes_to_int32(len - sizeof(xEvent));
+    raw->detail = ev->detail.button;
+    raw->deviceid = ev->deviceid;
+    raw->sourceid = ev->sourceid;
+    raw->valuators_len = vallen;
+    raw->flags = ev->flags & ~AINPUT_FAST_EVENT;
+
+    ptr = (char *) &raw[1];
+    memset(ptr, 0, raw->valuators_len * 4);
+
+    if (nvals == 2) {
+        axisval = (FP3232 *) (ptr + raw->valuators_len * 4);
+        axisval_raw = axisval + 2;
+        SetBit(ptr, 0);
+        SetBit(ptr, 1);
+        axisval[0] = AInputDoubleToFP3232(ev->valuators.data[0]);
+        axisval[1] = AInputDoubleToFP3232(ev->valuators.data[1]);
+        axisval_raw[0] = AInputDoubleToFP3232(ev->valuators.data_raw[0]);
+        axisval_raw[1] = AInputDoubleToFP3232(ev->valuators.data_raw[1]);
+    }
+
+    return Success;
+}
