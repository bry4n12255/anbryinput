+void
+QueueAInputRelativeMotion2DRawTimed(DeviceIntPtr device, double dx, double dy,
+                                    double raw_dx, double raw_dy, CARD32 ms)
+{
+    InternalEvent *events = InputEventList;
+    InternalEvent *out;
+    ValuatorMask mask;
+    int num_events = 0;
+
+    if (!device || !device->enabled || !device->valuator ||
+        device->valuator->numAxes < 2 || !miPointerGetScreen(device))
+        return;
+
+    out = UpdateFromMaster(events, device, DEVCHANGE_POINTER_EVENT,
+                           &num_events);
+    valuator_mask_zero(&mask);
+    valuator_mask_set_unaccelerated(&mask, 0, dx, raw_dx);
+    valuator_mask_set_unaccelerated(&mask, 1, dy, raw_dy);
+    num_events += fill_pointer_events(out, device, MotionNotify, 0, ms,
+                                      POINTER_RELATIVE, &mask);
+    queueEventList(device, events, num_events);
+}
