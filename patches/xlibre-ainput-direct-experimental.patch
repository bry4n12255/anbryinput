+/*
+ * Experimental AnbryInput-only relative 2D fast path.
+ *
+ * This intentionally supports only the narrow contract AnbryInput needs:
+ * relative mouse motion on axes 0/1, no acceleration, no scroll emulation,
+ * no absolute/tablet/touchpad handling, and no generic valuator traversal.
+ *
+ * It still preserves the externally important pieces:
+ * - XI_RawMotion
+ * - XI_Motion/core pointer motion
+ * - sprite movement, clipping, barriers, and screen crossing through
+ *   miPointerSetPosition()
+ * - master pointer last coordinates
+ *
+ * Drivers must only call this for simple relative pointer motion.
+ */
+void
+QueueAInputRelativeMotion2DRawTimed(DeviceIntPtr device, double dx, double dy,
+                                    double raw_dx, double raw_dy, CARD32 ms)
+{
+    InternalEvent *events = InputEventList;
+    InternalEvent *out;
+    RawDeviceEvent *raw;
+    DeviceEvent *event;
+    DeviceIntPtr master;
+    ScreenPtr scr;
+    ValuatorMask history_mask = {0};
+    int prefix_events;
+    int num_events = 0;
+    int barrier_events = 0;
+    double old_x, old_y;
+    double screenx, screeny;
+
+    if (!device || !device->enabled || !device->valuator ||
+        device->valuator->numAxes < 2)
+        return;
+
+    scr = miPointerGetScreen(device);
+    if (!scr)
+        return;
+
+    master = (!InputDevIsMaster(device) && !InputDevIsFloating(device)) ?
+             GetMaster(device, MASTER_POINTER) : NULL;
+    if (master && master->last.slave != device)
+        out = UpdateFromMaster(events, device, DEVCHANGE_POINTER_EVENT, &num_events);
+    else
+        out = events;
+    prefix_events = num_events;
+
+    raw = &out->raw_event;
+    init_raw(device, raw, ms, MotionNotify, 0);
+    SetBit(raw->valuators.mask, 0);
+    SetBit(raw->valuators.mask, 1);
+    raw->valuators.data_raw[0] = raw_dx;
+    raw->valuators.data_raw[1] = raw_dy;
+    raw->valuators.data[0] = raw_dx;
+    raw->valuators.data[1] = raw_dy;
+    /* Use the server's standard XI2 wire conversion for client compatibility. */
+    raw->flags = 0;
+    out++;
+    num_events++;
+
+    old_x = device->last.valuators[0];
+    old_y = device->last.valuators[1];
+    screenx = old_x + dx;
+    screeny = old_y + dy;
+
+    scr = miPointerSetPosition(device, Relative, &screenx, &screeny,
+                               &barrier_events, out);
+    out += barrier_events;
+    num_events += barrier_events;
+
+    history_mask.last_bit = 1;
+    history_mask.mask[0] = 0x3;
+    history_mask.valuators[0] = screenx - scr->x;
+    history_mask.valuators[1] = screeny - scr->y;
+    updateHistory(device, &history_mask, ms);
+
+    device->last.valuators[0] = screenx;
+    device->last.valuators[1] = screeny;
+
+    if (master) {
+        master->last.valuators[0] = screenx;
+        master->last.valuators[1] = screeny;
+    }
+
+    event = &out->device_event;
+    init_device_event(event, device, ms, EVENT_SOURCE_NORMAL);
+    event->type = ET_Motion;
+    event->detail.button = 0;
+    event_set_root_coordinates(event, screenx - scr->x, screeny - scr->y);
+    SetBit(event->valuators.mask, 0);
+    SetBit(event->valuators.mask, 1);
+    event->valuators.data[0] = screenx - scr->x;
+    event->valuators.data[1] = screeny - scr->y;
+    event->flags = 0;
+    out++;
+    num_events++;
+
+    if (prefix_events == 0 && barrier_events == 0)
+        mieqEnqueueAInputMotionPair(device, &InputEventList[0],
+                                    &InputEventList[1]);
+    else
+        queueEventList(device, InputEventList, num_events);
+}
+
+/*
+ * Experimental AnbryInput-only mouse button fast path.
+ *
+ * This path is meant for ordinary pointer buttons. Scroll buttons should stay
+ * on the normal Xorg/XLibre path so smooth scrolling and legacy emulation keep
+ * their usual behavior.
+ */
+void
+QueueAInputButton(DeviceIntPtr device, int button, int is_down)
+{
+    CARD32 ms = GetTimeInMillis();
+    InternalEvent *events = InputEventList;
+    InternalEvent *out;
+    RawDeviceEvent *raw;
+    DeviceEvent *event;
+    ScreenPtr scr;
+    int prefix_events;
+    int num_events = 0;
+    int type;
+
+    if (!device || !device->enabled || !device->button || !button ||
+        button >= MAX_BUTTONS)
+        return;
+
+    scr = miPointerGetScreen(device);
+    if (!scr)
+        return;
+
+    type = is_down ? ButtonPress : ButtonRelease;
+    if (!!is_down == !!button_is_down(device, button, BUTTON_POSTED))
+        return;
+
+    out = UpdateFromMaster(events, device, DEVCHANGE_POINTER_EVENT, &num_events);
+    prefix_events = num_events;
+
+    raw = &out->raw_event;
+    init_raw(device, raw, ms, type, button);
+    raw->flags = 0;
+    out++;
+    num_events++;
+
+    event = &out->device_event;
+    init_device_event(event, device, ms, EVENT_SOURCE_NORMAL);
+    event->type = is_down ? ET_ButtonPress : ET_ButtonRelease;
+    event->detail.button = button;
+    event->flags = 0;
+    event_set_root_coordinates(event,
+                               device->last.valuators[0] - scr->x,
+                               device->last.valuators[1] - scr->y);
+
+    if (is_down)
+        set_button_down(device, button, BUTTON_POSTED);
+    else
+        set_button_up(device, button, BUTTON_POSTED);
+
+    out++;
+    num_events++;
+
+    if (prefix_events == 0)
+        mieqEnqueueAInputButtonPair(device, &InputEventList[0],
+                                    &InputEventList[1]);
+    else
+        queueEventList(device, InputEventList, num_events);
+}
