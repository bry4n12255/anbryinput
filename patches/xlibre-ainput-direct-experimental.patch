+static inline void
+mieqEnqueueAInputPair(DeviceIntPtr pDev, InternalEvent *first,
+                      InternalEvent *second, int second_is_motion)
+{
+    InternalEvent *first_out;
+    InternalEvent *second_out;
+    ScreenPtr screen;
+    unsigned int first_tail;
+    unsigned int second_tail;
+    size_t n_enqueued;
+    Time time;
+
+    if (!first || !second ||
+        first->any.length == 0 || first->any.length > sizeof(InternalEvent) ||
+        second->any.length == 0 || second->any.length > sizeof(InternalEvent) ||
+        !((first->any.type == ET_RawMotion &&
+           second->any.type == ET_Motion) ||
+          (first->any.type == ET_RawButtonPress &&
+           second->any.type == ET_ButtonPress) ||
+          (first->any.type == ET_RawButtonRelease &&
+           second->any.type == ET_ButtonRelease))) {
+        miEventQueue.dropped++;
+        return;
+    }
+
+    n_enqueued = mieqNumEnqueued(&miEventQueue);
+    if (n_enqueued + 2 >= miEventQueue.nevents) {
+        if (!mieqGrowQueue(&miEventQueue, miEventQueue.nevents << 1)) {
+            miEventQueue.dropped++;
+            return;
+        }
+    }
+
+    time = first->any.time;
+    if (time < miEventQueue.lastEventTime &&
+        miEventQueue.lastEventTime - time < 10000)
+        time = miEventQueue.lastEventTime;
+
+    screen = pDev ? EnqueueScreen(pDev) : NULL;
+    first_tail = miEventQueue.tail;
+    second_tail = (first_tail + 1) % miEventQueue.nevents;
+    first_out = miEventQueue.events[first_tail].events;
+    second_out = miEventQueue.events[second_tail].events;
+
+    memcpy(first_out, first, first->any.length);
+    memcpy(second_out, second, second->any.length);
+    first_out->any.time = time;
+    second_out->any.time = time;
+
+    miEventQueue.events[first_tail].pScreen = screen;
+    miEventQueue.events[first_tail].pDev = pDev;
+    miEventQueue.events[second_tail].pScreen = screen;
+    miEventQueue.events[second_tail].pDev = pDev;
+    miEventQueue.lastEventTime = time;
+    miEventQueue.lastMotion = second_is_motion;
+    miEventQueue.tail = (second_tail + 1) % miEventQueue.nevents;
+}
