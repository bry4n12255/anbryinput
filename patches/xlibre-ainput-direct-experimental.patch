+void
+QueueAInputKeyTimed(DeviceIntPtr device, int keycode, int is_down, CARD32 ms)
+{
+    InternalEvent *raw_slot;
+    InternalEvent *event_slot;
+    RawDeviceEvent *raw;
+    DeviceEvent *event;
+    DeviceIntPtr master;
+    int type = is_down ? KeyPress : KeyRelease;
+
+    if (!device || !device->enabled || !device->key || !device->focus ||
+        !device->kbdfeed || keycode < 8 || keycode > 255)
+        return;
+
+    if (is_down && key_is_down(device, keycode, KEY_POSTED)) {
+        QueueKeyboardEvents(device, type, keycode);
+        return;
+    }
+
+    master = GetMaster(device, MASTER_KEYBOARD);
+    if (master && master->last.slave != device) {
+        QueueKeyboardEvents(device, type, keycode);
+        return;
+    }
+
+    if (!mieqReserveAInputPair(&raw_slot, &event_slot)) {
+        QueueKeyboardEvents(device, type, keycode);
+        return;
+    }
+
+    raw = &raw_slot->raw_event;
+    event = &event_slot->device_event;
+    init_raw(device, raw, ms, type, keycode);
+    init_device_event(event, device, ms, EVENT_SOURCE_NORMAL);
+    event->type = is_down ? ET_KeyPress : ET_KeyRelease;
+    event->detail.key = keycode;
+
+    if (is_down)
+        set_key_down(device, keycode, KEY_POSTED);
+    else
+        set_key_up(device, keycode, KEY_POSTED);
+
+    mieqCommitAInputPair(device, 0);
+}
