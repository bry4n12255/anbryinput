+void
+QueueAInputRelativeMotion2DRawAtTime(DeviceIntPtr device, double dx, double dy,
+                                     double raw_dx, double raw_dy, CARD32 ms)
+{
+    InternalEvent *events = InputEventList;
+    InternalEvent *out;
+    ValuatorMask mask;
+    int num_events = 0;
+    if (!device || !device->enabled || !device->valuator ||
+        device->valuator->numAxes < 2 || !miPointerGetScreen(device))
+        return;
+
+    /* Every consumer is bounded by last_bit; leave the unused tail alone. */
+    mask.last_bit = 1;
+    mask.has_unaccelerated = TRUE;
+    mask.mask[0] = 0x03;
+    mask.valuators[0] = dx;
+    mask.valuators[1] = dy;
+    mask.unaccelerated[0] = raw_dx;
+    mask.unaccelerated[1] = raw_dy;
+
+#ifdef XSERVER_DTRACE
+    if (XSERVER_INPUT_EVENT_ENABLED())
+        XSERVER_INPUT_EVENT(device->id, MotionNotify, 0, POINTER_RELATIVE, 2,
+                            mask.mask, mask.valuators);
+#endif
+
+    out = UpdateFromMaster(events, device, DEVCHANGE_POINTER_EVENT,
+                           &num_events);
+    num_events += fill_pointer_events_mutable(out, device, MotionNotify, 0, ms,
+                                              POINTER_RELATIVE, &mask, FALSE);
+    queueEventList(device, events, num_events);
+}
+
+void
+QueueAInputRelativeMotion2DRaw(DeviceIntPtr device, double dx, double dy,
+                               double raw_dx, double raw_dy)
+{
+    QueueAInputRelativeMotion2DRawAtTime(device, dx, dy, raw_dx, raw_dy,
+                                         GetTimeInMillis());
+}
+
+void
+QueueAInputButtonAtTime(DeviceIntPtr device, int button, int is_down, CARD32 ms)
+{
+    InternalEvent *events = InputEventList;
+    int num_events;
+
+    if (!device || !device->enabled || !device->button ||
+        button <= 0 || button >= MAX_BUTTONS)
+        return;
+    num_events = ainput_get_pointer_events_at_time(
+        events, device, is_down ? ButtonPress : ButtonRelease, button, 0,
+        NULL, ms);
+    queueEventList(device, events, num_events);
+}
