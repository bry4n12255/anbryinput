+
+typedef struct {
+    XF86OptionPtr options;
+    InputAttributes *attrs;
+    char *name;
+    DeviceIntPtr old_dev;
+    DeviceIntPtr master;
+    Bool enabled;
+} InputHotReloadDeviceRec;
+
+static char *input_hot_reload_driver;
+static volatile sig_atomic_t input_hot_reload_pending;
+static XF86OptionPtr xf86InputHotReloadBaseOptions(InputInfoPtr pInfo);
+
+static void
+xf86InputHotReloadSignal(int sig)
+{
+    (void) sig;
+    input_hot_reload_pending = 1;
+}
+
+void
+xf86InputHotReloadEnable(const char *driver)
+{
+#if defined(__linux__) && defined(SIGUSR2)
+    free(input_hot_reload_driver);
+    input_hot_reload_driver = xstrdup(driver);
+    if (!input_hot_reload_driver)
+        FatalError("Cannot allocate input hot reload driver name\n");
+#else
+    (void) driver;
+    FatalError("-inputdevreload is only supported on Linux with SIGUSR2\n");
+#endif
+}
+
+void
+xf86InputHotReloadInit(void)
+{
+#if defined(__linux__) && defined(SIGUSR2)
+    input_hot_reload_pending = 0;
+    if (input_hot_reload_driver) {
+        OsSignal(SIGUSR2, xf86InputHotReloadSignal);
+        xf86Msg(X_INFO,
+                "Input hot reload enabled for '%s'; send SIGUSR2 to reload\n",
+                input_hot_reload_driver);
+    }
+#endif
+}
+
+static void
+xf86InputHotReloadFreeSnapshots(InputHotReloadDeviceRec *devices, int count)
+{
+    int i;
+
+    if (!devices)
+        return;
+
+    for (i = 0; i < count; i++) {
+        xf86optionListFree(devices[i].options);
+        FreeInputAttributes(devices[i].attrs);
+        free(devices[i].name);
+    }
+    free(devices);
+}
+
+void
+xf86InputHotReloadCheck(void)
+{
+#if defined(__linux__) && defined(SIGUSR2)
+    InputHotReloadDeviceRec *devices = NULL;
+    InputDriverPtr driver;
+    InputInfoPtr pInfo;
+    int driver_index = -1;
+    int count = 0;
+    int i = 0;
+    int recreated = 0;
+
+    if (!input_hot_reload_driver || !input_hot_reload_pending)
+        return;
+
+    input_hot_reload_pending = 0;
+    driver = xf86LookupInputDriver(input_hot_reload_driver);
+    if (!driver) {
+        xf86Msg(X_ERROR, "Input hot reload: driver '%s' is not loaded\n",
+                input_hot_reload_driver);
+        return;
+    }
+
+    for (i = 0; i < xf86NumInputDrivers; i++) {
+        if (xf86InputDriverList[i] == driver) {
+            driver_index = i;
+            break;
+        }
+    }
+    if (driver_index < 0) {
+        xf86Msg(X_ERROR,
+                "Input hot reload: driver '%s' has no module-list entry\n",
+                input_hot_reload_driver);
+        return;
+    }
+
+    for (pInfo = xf86InputDevs; pInfo; pInfo = pInfo->next) {
+        if (pInfo->drv != driver)
+            continue;
+        if (!pInfo->dev) {
+            xf86Msg(X_ERROR,
+                    "Input hot reload: '%s' has no X device; reload aborted\n",
+                    pInfo->name);
+            return;
+        }
+        count++;
+    }
+
+    if (count) {
+        devices = calloc(count, sizeof(*devices));
+        if (!devices) {
+            xf86Msg(X_ERROR, "Input hot reload: snapshot allocation failed\n");
+            return;
+        }
+    }
+
+    i = 0;
+    for (pInfo = xf86InputDevs; pInfo; pInfo = pInfo->next) {
+        if (pInfo->drv != driver)
+            continue;
+
+        devices[i].options = xf86InputHotReloadBaseOptions(pInfo);
+        if (pInfo->options && !devices[i].options) {
+            xf86Msg(X_ERROR,
+                    "Input hot reload: cannot copy options for '%s'\n",
+                    pInfo->name);
+            xf86InputHotReloadFreeSnapshots(devices, count);
+            return;
+        }
+        devices[i].attrs = DuplicateInputAttributes(pInfo->attrs);
+        if (pInfo->attrs && !devices[i].attrs) {
+            xf86Msg(X_ERROR,
+                    "Input hot reload: cannot copy attributes for '%s'\n",
+                    pInfo->name);
+            xf86InputHotReloadFreeSnapshots(devices, count);
+            return;
+        }
+        devices[i].name = xstrdup(pInfo->name);
+        if (!devices[i].name) {
+            xf86Msg(X_ERROR,
+                    "Input hot reload: cannot copy name for '%s'\n",
+                    pInfo->name);
+            xf86InputHotReloadFreeSnapshots(devices, count);
+            return;
+        }
+        devices[i].old_dev = pInfo->dev;
+        devices[i].master = GetMaster(pInfo->dev, MASTER_ATTACHED);
+        devices[i].enabled = pInfo->dev->enabled;
+        i++;
+    }
+
+    if (!xf86ReloadInputClasses()) {
+        xf86Msg(X_ERROR,
+                "Input hot reload: could not reread InputClass configuration; "
+                "reload aborted\n");
+        xf86InputHotReloadFreeSnapshots(devices, count);
+        return;
+    }
+
+    xf86Msg(X_INFO, "Input hot reload: replacing driver '%s' (%d device%s)\n",
+            input_hot_reload_driver, count, count == 1 ? "" : "s");
+
+    input_lock();
+    for (i = 0; i < count; i++)
+        DeleteInputDeviceRequest(devices[i].old_dev);
+
+    xf86DeleteInputDriver(driver_index);
+
+    if (!xf86LoadOneModule(input_hot_reload_driver, NULL) ||
+        !xf86LookupInputDriver(input_hot_reload_driver)) {
+        xf86Msg(X_ERROR,
+                "Input hot reload: failed to load new '%s' module; "
+                "devices remain removed\n",
+                input_hot_reload_driver);
+        input_unlock();
+        xf86InputHotReloadFreeSnapshots(devices, count);
+        return;
+    }
+
+    for (i = 0; i < count; i++) {
+        DeviceIntPtr dev = NULL;
+        InputInfoPtr new_info;
+        int rc;
+
+        rc = NewInputDeviceRequest(devices[i].options, devices[i].attrs, &dev);
+        if (rc != Success) {
+            xf86Msg(X_ERROR,
+                    "Input hot reload: '%s' recreation failed (%d)\n",
+                    devices[i].name, rc);
+            continue;
+        }
+
+        new_info = dev->public.devicePrivate;
+        if (GetMaster(dev, MASTER_ATTACHED) != devices[i].master &&
+            AttachDevice(NULL, dev, devices[i].master) != Success)
+            xf86Msg(X_WARNING,
+                    "Input hot reload: could not restore master for '%s'\n",
+                    new_info->name);
+        if (!devices[i].enabled && dev->enabled)
+            xf86DisableDevice(dev, FALSE);
+        recreated++;
+    }
+
+    xf86Msg(recreated == count ? X_INFO : X_WARNING,
+            "Input hot reload: recreated %d of %d device%s with new '%s' code\n",
+            recreated, count, count == 1 ? "" : "s",
+            input_hot_reload_driver);
+    input_unlock();
+    xf86InputHotReloadFreeSnapshots(devices, count);
+#endif
+}
