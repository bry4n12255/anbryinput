+static XF86OptionPtr
+xf86InputHotReloadRemoveOption(XF86OptionPtr options, const char *name)
+{
+    XF86OptionPtr option = xf86FindOption(options, name);
+
+    if (option)
+        options = input_option_free_element(options, xf86OptionName(option));
+    return options;
+}
+
+static XF86OptionPtr
+xf86InputHotReloadBaseOptions(InputInfoPtr pInfo)
+{
+    XF86ConfInputClassPtr cl;
+    XF86OptionPtr option;
+    XF86OptionPtr options = xf86OptionListDuplicate(pInfo->options);
+
+    if (!options)
+        return NULL;
+
+    for (cl = xf86configptr->conf_inputclass_lst; cl; cl = cl->list.next) {
+        if (!pInfo->attrs || !InputClassMatches(cl, pInfo, pInfo->attrs))
+            continue;
+
+        for (option = cl->option_lst; option; option = xf86NextOption(option))
+            options = xf86InputHotReloadRemoveOption(
+                options, xf86OptionName(option));
+        if (cl->driver)
+            options = xf86InputHotReloadRemoveOption(options, "driver");
+    }
+
+    options = xf86InputHotReloadRemoveOption(options, "fd");
+    options = xf86AddNewOption(options, "driver", input_hot_reload_driver);
+    if (!xf86FindOption(options, "name") &&
+        !xf86FindOption(options, "identifier"))
+        options = xf86AddNewOption(options, "identifier", pInfo->name);
+    return options;
+}
