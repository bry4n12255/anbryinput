+Bool
+xf86ReloadInputClasses(void)
+{
+    XF86ConfigPtr active = xf86configptr;
+    XF86ConfigPtr fresh;
+    XF86ConfInputClassPtr old_classes;
+    const char *filesearch;
+    const char *dirsearch;
+    char *filename;
+    char *dirname;
+    char *sysdirname;
+
+    if (!active)
+        return FALSE;
+
+    if (!PrivsElevated()) {
+        filesearch = ALL_CONFIGPATH;
+        dirsearch = ALL_CONFIGDIRPATH;
+    }
+    else {
+        filesearch = RESTRICTED_CONFIGPATH;
+        dirsearch = RESTRICTED_CONFIGDIRPATH;
+    }
+
+    xf86configptr = NULL;
+    xf86initConfigFiles();
+    sysdirname = xf86openConfigDirFiles(SYS_CONFIGDIRPATH, NULL, PROJECTROOT);
+    dirname = xf86openConfigDirFiles(dirsearch, input_reload_config_dir,
+                                     PROJECTROOT);
+    filename = xf86openConfigFile(filesearch, input_reload_config_file,
+                                  PROJECTROOT);
+
+    if (!filename && !dirname && !sysdirname) {
+        xf86closeConfigFile();
+        xf86configptr = active;
+        return FALSE;
+    }
+
+    free(filename);
+    free(dirname);
+    free(sysdirname);
+    fresh = xf86readConfigFile();
+    xf86closeConfigFile();
+    xf86configptr = active;
+    if (!fresh)
+        return FALSE;
+
+    old_classes = active->conf_inputclass_lst;
+    active->conf_inputclass_lst = fresh->conf_inputclass_lst;
+    fresh->conf_inputclass_lst = NULL;
+    xf86freeInputClassList(old_classes);
+    xf86freeConfig(fresh);
+
+    xf86Msg(X_INFO, "Reloaded InputClass configuration from disk\n");
+    return TRUE;
+}
