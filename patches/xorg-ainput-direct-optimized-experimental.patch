+Bool
+mieqReserveAInputPair(InternalEvent **first, InternalEvent **second)
+{
+    unsigned int first_tail = miEventQueue.tail;
+    unsigned int second_tail = first_tail + 1;
+    unsigned int new_tail;
+
+    if (second_tail == miEventQueue.nevents)
+        second_tail = 0;
+    new_tail = second_tail + 1;
+    if (new_tail == miEventQueue.nevents)
+        new_tail = 0;
+
+    if (second_tail == miEventQueue.head || new_tail == miEventQueue.head) {
+        if (!mieqGrowQueue(&miEventQueue, miEventQueue.nevents << 1)) {
+            miEventQueue.dropped++;
+            return FALSE;
+        }
+        first_tail = miEventQueue.tail;
+        second_tail = first_tail + 1;
+    }
+
+    *first = miEventQueue.events[first_tail].events;
+    *second = miEventQueue.events[second_tail].events;
+    return TRUE;
+}
+
+void
+mieqCommitAInputPair(DeviceIntPtr pDev, int last_motion)
+{
+    ScreenPtr screen = EnqueueScreen(pDev);
+    unsigned int first_tail = miEventQueue.tail;
+    unsigned int second_tail = first_tail + 1;
+    InternalEvent *first;
+    InternalEvent *second;
+    Time time;
+
+    if (second_tail == miEventQueue.nevents)
+        second_tail = 0;
+    first = miEventQueue.events[first_tail].events;
+    second = miEventQueue.events[second_tail].events;
+    time = first->any.time;
+    if (time < miEventQueue.lastEventTime &&
+        miEventQueue.lastEventTime - time < 10000)
+        time = miEventQueue.lastEventTime;
+    first->any.time = time;
+    second->any.time = time;
+    miEventQueue.events[first_tail].pScreen = screen;
+    miEventQueue.events[first_tail].pDev = pDev;
+    miEventQueue.events[second_tail].pScreen = screen;
+    miEventQueue.events[second_tail].pDev = pDev;
+    miEventQueue.lastEventTime = time;
+    miEventQueue.lastMotion = last_motion;
+    miEventQueue.tail = second_tail + 1;
+    if (miEventQueue.tail == miEventQueue.nevents)
+        miEventQueue.tail = 0;
+}
